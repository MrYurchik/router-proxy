# ── Required: Provider API keys ──
GO_API_KEY=sk-your-opencode-go-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# ── Optional: Telegram notifications ──
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
TELEGRAM_CHAT_ID=-1001234567890

# ── Optional: Config path (default: ../hermes-routing.yaml) ──
# ROUTING_CONFIG=/home/yurii/home-server/hermes-routing.yaml

# ── Optional: Proxy port (default: 8787) ──
# PORT=8787

# ── Optional: State DB path (default: ../proxy_state.db) ──
# PROXY_STATE_DB=/home/yurii/proxy_state.db
