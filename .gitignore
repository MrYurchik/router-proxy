# Hermes Routing Proxy — .gitignore

# Environment & secrets
.env
.env.local
*.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Testing & quality
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.coverage
htmlcov/

# Build artifacts
dist/
build/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Systemd service (user-specific, not committed)
*.service

# Routing config (symlinked or local copy — use env var ROUTING_CONFIG)
hermes-routing.yaml

# Documentation build (if using mkdocs/docsify)
site/
_site/

# Editor tmp files
*.swp
*.swo
*~
